APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# RCPA SQL Server (RCP-AUS-SQL01) - additional read-only connection (not the app default).
# Copy these keys into your local `.env` and fill values there only.
# Never commit real usernames, passwords, or connection URLs.
# Requires Microsoft ODBC Driver for SQL Server plus PHP pdo_sqlsrv/sqlsrv in Herd.
# You must be on the corporate network or VPN so RCP-AUS-SQL01 resolves in DNS. Then run: php artisan rcpa:sql-status --views
# After the connection is ok, pull mapped views with: php artisan rcpa:pull-views
# App access is Eloquent only (App\Models\Rcpa\*) via Data > ERP Views and the Production Board. Do not query this server with raw SQL.
# If the internal TLS certificate is untrusted, set RCPA_SQL_TRUST_SERVER_CERTIFICATE=true in local `.env` only.
# A failed handshake is cached for 60s so an unreachable server cannot stall a page.
# Use the "Retry connection" button on Data > ERP Views after joining the VPN to clear it.
RCPA_SQL_HOST=RCP-AUS-SQL01
RCPA_SQL_PORT=1433
RCPA_SQL_DATABASE=
RCPA_SQL_USERNAME=
RCPA_SQL_PASSWORD=
RCPA_SQL_ENCRYPT=yes
RCPA_SQL_TRUST_SERVER_CERTIFICATE=false
RCPA_SQL_LOGIN_TIMEOUT=5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microsoft Graph dispatch email (application permission: Mail.Send).
# Store real values only in the deployment environment or local .env.
DISPATCH_NOTIFICATION_DRIVER=microsoft-graph
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
